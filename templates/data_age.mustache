{{!
    @template local_chronifycompliance/data_age

    How old the data on the page is, with Refresh now.

    Example context (json):
    {
        "dataset": "activity", "hastime": true, "time": "2:14 AM today",
        "refreshing": false, "failed": false, "canrefresh": true
    }
}}
<p class="local-chronifycompliance-dataage small text-muted mb-3" data-region="data-age" data-dataset="{{dataset}}">
    {{#hastime}}{{#str}}dataage:updated, local_chronifycompliance, {{time}}{{/str}}{{/hastime}}
    {{^hastime}}{{#str}}dataage:never, local_chronifycompliance{{/str}}{{/hastime}}
    {{#refreshing}}<span class="ms-1">{{#str}}dataage:refreshing, local_chronifycompliance{{/str}}</span>{{/refreshing}}
    {{#failed}}<span class="ms-1 text-danger">{{#str}}dataage:failed, local_chronifycompliance{{/str}}</span>{{/failed}}
    {{#canrefresh}}
        <button type="button" class="btn btn-link btn-sm p-0 ms-1 align-baseline" data-action="cc-refresh" data-dataset="{{dataset}}">
            {{#str}}dataage:refreshnow, local_chronifycompliance{{/str}}
        </button>
    {{/canrefresh}}
    <span class="ms-1 d-none" data-region="data-age-note" role="status"></span>
</p>
{{#js}}
    require(['local_chronifycompliance/page_components'], function(components) {
        components.init();
    });
{{/js}}
