{{!
    @template local_chronifycompliance/undo_toast

    Shown for 30 seconds after a fix was applied.

    Example context (json):
    {
        "fixlogid": 7, "inline": false, "message": "Grade to pass set to 7 out of 10."
    }
}}
<div class="local-chronifycompliance-toast{{^inline}} position-fixed{{/inline}} p-3 bg-dark text-white rounded shadow" role="status" data-region="undo-toast">
    <div class="d-flex align-items-center">
        <div class="me-3">{{message}}</div>
        <button type="button" class="btn btn-light btn-sm me-2" data-action="cc-toast-undo">
            {{#str}}report:undo, local_chronifycompliance{{/str}}
        </button>
        <button type="button" class="btn btn-link btn-sm text-white p-0" data-action="cc-toast-close"
            aria-label="{{#str}}closebuttontitle, core{{/str}}"><span aria-hidden="true">&times;</span></button>
    </div>
</div>
