{{!
    @template local_chronifycompliance/invitation

    A soft invitation with a link and a dismiss button.

    Example context (json):
    {
        "key": "dashboard", "preference": "local_chronifycompliance_invite_dashboard",
        "message": "Want a second pair of eyes on your site?", "linktext": "See how Sebale can help",
        "url": "https://chronifyai.com"
    }
}}
<aside class="local-chronifycompliance-invitation alert alert-light border d-flex align-items-start justify-content-between mb-3"
        data-region="invitation" data-key="{{key}}" data-preference="{{preference}}">
    <div>
        {{message}}
        <a href="{{url}}" target="_blank" rel="noopener" class="ms-1">{{linktext}}</a>
    </div>
    <button type="button" class="btn btn-link btn-sm p-0 ms-3" data-action="cc-dismiss-invitation">
        {{#str}}invite:dismiss, local_chronifycompliance{{/str}}
    </button>
</aside>
{{#js}}
    require(['local_chronifycompliance/page_components'], function(components) {
        components.init();
    });
{{/js}}
