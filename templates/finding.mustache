{{!
    @template local_chronifycompliance/finding

    One finding with its actions.

    Example context (json):
    {
        "id": 12, "checkname": "Pass grade missing", "checkdesc": "A passing grade is required but none is set.",
        "message": "Quiz \"Final test\" requires a passing grade, but its grade to pass is 0.",
        "severitylabel": "Critical", "badgeclass": "lcd-pill lcd-pill-critical", "cmname": "Final test",
        "cmurl": "https://example.com/mod/quiz/view.php?id=4", "editurl": "https://example.com/course/modedit.php?update=4",
        "scormurl": null, "canfix": true, "canignore": true, "canreopen": false, "fixlogid": null,
        "ignorereason": null, "timeignored": null
    }
}}
<div class="local-chronifycompliance-finding card mb-2" data-region="finding" data-findingid="{{id}}">
    <div class="card-body p-3">
        <div class="d-flex flex-wrap align-items-start justify-content-between">
            <div class="me-3 mb-2">
                <h4 class="h6 mb-1"><span class="{{badgeclass}} me-2">{{severitylabel}}</span>{{checkname}}</h4>
                <p class="mb-1">{{message}}</p>
                {{#cmname}}
                    <p class="mb-1 small">
                        {{#cmurl}}<a href="{{cmurl}}">{{cmname}}</a>{{/cmurl}}{{^cmurl}}{{cmname}}{{/cmurl}}
                        {{#editurl}} · <a href="{{editurl}}">{{#str}}report:editsettings, local_chronifycompliance{{/str}}</a>{{/editurl}}
                        {{#scormurl}} · <a href="{{scormurl}}">{{#str}}report:scormpanel, local_chronifycompliance{{/str}}</a>{{/scormurl}}
                    </p>
                {{/cmname}}
                {{#ignorereason}}
                    <p class="mb-1 small text-muted">{{#str}}report:ignoredbecause, local_chronifycompliance, {{ignorereason}}{{/str}}</p>
                {{/ignorereason}}
                <details class="small text-muted">
                    <summary>{{#str}}report:whythismatters, local_chronifycompliance{{/str}}</summary>
                    <p class="mt-1 mb-0">{{checkdesc}}</p>
                </details>
            </div>
            <div class="btn-group-sm text-nowrap">
                {{#canfix}}
                    <button type="button" class="btn btn-primary btn-sm mb-1" data-action="cd-preview-fix" data-findingid="{{id}}">
                        {{#str}}report:previewfix, local_chronifycompliance{{/str}}
                    </button>
                {{/canfix}}
                {{#fixlogid}}
                    <button type="button" class="btn btn-outline-secondary btn-sm mb-1" data-action="cd-undo-fix" data-fixlogid="{{fixlogid}}">
                        {{#str}}report:undo, local_chronifycompliance{{/str}}
                    </button>
                {{/fixlogid}}
                {{#canignore}}
                    <button type="button" class="btn btn-outline-secondary btn-sm mb-1" data-action="cd-ignore" data-findingid="{{id}}">
                        {{#str}}report:ignore, local_chronifycompliance{{/str}}
                    </button>
                {{/canignore}}
                {{#canreopen}}
                    <button type="button" class="btn btn-outline-secondary btn-sm mb-1" data-action="cd-reopen" data-findingid="{{id}}">
                        {{#str}}report:reopen, local_chronifycompliance{{/str}}
                    </button>
                {{/canreopen}}
            </div>
        </div>
    </div>
</div>
