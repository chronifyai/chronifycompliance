{{!
    @template local_chronifycompliance/course_report

    Course completion health report: header, tabs Problems, Ignored, Fixed and Links, and the open tab.

    Example context (json):
    {
        "courseid": 2, "tab": "problems", "checking": false, "checked": "Checked 1:30 AM today",
        "recheckurl": "https://example.com/local/chronifycompliance/course.php?id=2", "sesskey": "abc",
        "tabs": [{"key": "problems", "label": "Problems (1)", "url": "https://example.com/?tab=problems", "active": true}],
        "isproblems": true, "isignored": false, "isfixed": false, "islinks": false,
        "summary": {"critical": 1, "warning": 0, "info": 0, "total": 1, "lastaudit": "Today", "neveraudited": false},
        "groups": [], "hasopen": false, "ignored": [], "hasignored": false, "history": [], "hashistory": false,
        "learnerurl": "https://example.com/local/chronifycompliance/learner.php?courseid=2",
        "completionsettingsurl": "https://example.com/course/completion.php?id=2", "links": null, "scormwaiting": null
    }
}}
<div class="local-chronifycompliance-report" data-region="course-report" data-courseid="{{courseid}}">
    <div class="d-flex flex-wrap justify-content-between align-items-start mb-2">
        <div class="me-3 mb-2">
            <h2 class="h3 mb-1">{{#str}}report:title, local_chronifycompliance{{/str}}</h2>
            <form method="post" action="{{recheckurl}}" class="small text-muted d-inline">
                {{#checked}}{{checked}}{{/checked}}
                {{^checked}}{{#str}}report:neveraudited, local_chronifycompliance{{/str}}{{/checked}}
                <input type="hidden" name="sesskey" value="{{sesskey}}">
                <input type="hidden" name="action" value="recheck">
                <button type="submit" class="btn btn-link btn-sm p-0 ms-1 align-baseline">{{#str}}report:recheck, local_chronifycompliance{{/str}}</button>
            </form>
        </div>
        <div class="d-flex flex-wrap mb-2">
            {{#learnerurl}}<a class="btn btn-outline-secondary btn-sm me-2 mb-1" href="{{learnerurl}}">{{#str}}report:learnerlink, local_chronifycompliance{{/str}}</a>{{/learnerurl}}
            <a class="btn btn-outline-secondary btn-sm mb-1" href="{{completionsettingsurl}}">{{#str}}report:completionsettings, local_chronifycompliance{{/str}}</a>
        </div>
    </div>
    {{#checking}}<div class="alert alert-info" data-region="checking">{{#str}}report:checking, local_chronifycompliance{{/str}}</div>{{/checking}}

    <ul class="nav nav-tabs mb-3" data-region="report-tabs" aria-label="{{#str}}report:navigation, local_chronifycompliance{{/str}}">
        {{#tabs}}
            <li class="nav-item">
                <a class="nav-link{{#active}} active{{/active}}" href="{{url}}" data-tab="{{key}}"{{#active}} aria-current="page"{{/active}}>{{label}}</a>
            </li>
        {{/tabs}}
    </ul>

    {{#isproblems}}
        {{#summary}}{{> local_chronifycompliance/summary_bar }}{{/summary}}
        {{#scormwaiting}}
            <div class="alert alert-info" data-region="scorm-waiting">
                <p class="mb-2">{{message}}</p>
                <ul class="list-unstyled mb-0">
                    {{#items}}
                        <li class="d-flex flex-wrap align-items-center mb-1">
                            <span class="me-2">{{name}} <span class="text-muted">({{size}})</span></span>
                            <form method="post" action="{{actionurl}}">
                                <input type="hidden" name="sesskey" value="{{sesskey}}">
                                <input type="hidden" name="action" value="analyzescorm">
                                <input type="hidden" name="cmid" value="{{cmid}}">
                                <button type="submit" class="btn btn-sm btn-secondary">{{#str}}report:analyzenow, local_chronifycompliance{{/str}}</button>
                            </form>
                        </li>
                    {{/items}}
                </ul>
            </div>
        {{/scormwaiting}}
        {{#groups}}
            <section class="mb-4" aria-labelledby="cd-group-{{severity}}">
                <h3 class="h5" id="cd-group-{{severity}}">{{label}} ({{count}})</h3>
                {{#findings}}{{> local_chronifycompliance/finding }}{{/findings}}
            </section>
        {{/groups}}
        {{^hasopen}}
            {{^summary.neveraudited}}<p class="text-muted">{{#str}}report:noopen, local_chronifycompliance{{/str}}</p>{{/summary.neveraudited}}
        {{/hasopen}}
    {{/isproblems}}

    {{#isignored}}
        {{#ignored}}{{> local_chronifycompliance/finding }}{{/ignored}}
        {{^hasignored}}<p class="text-muted">{{#str}}report:noignored, local_chronifycompliance{{/str}}</p>{{/hasignored}}
    {{/isignored}}

    {{#isfixed}}
        {{#hashistory}}
            <p class="small text-muted">{{#str}}report:undoable, local_chronifycompliance{{/str}}</p>
            <ul class="list-unstyled" data-region="fix-history">
                {{#history}}
                    <li class="card mb-2" data-fixlogid="{{fixlogid}}">
                        <div class="card-body p-3 d-flex flex-wrap justify-content-between align-items-start">
                            <div class="me-3">
                                <div class="fw-bold">{{checkname}}{{#cmname}} <span class="fw-normal text-muted">({{cmname}})</span>{{/cmname}}</div>
                                <div class="small">{{applied}}</div>
                                {{#undone}}<div class="small text-muted">{{undone}}</div>{{/undone}}
                            </div>
                            {{#canundo}}
                                <button type="button" class="btn btn-outline-secondary btn-sm" data-action="cd-undo-fix" data-fixlogid="{{fixlogid}}">
                                    {{#str}}report:undo, local_chronifycompliance{{/str}}
                                </button>
                            {{/canundo}}
                        </div>
                    </li>
                {{/history}}
            </ul>
        {{/hashistory}}
        {{^hashistory}}<p class="text-muted">{{#str}}report:nofixes, local_chronifycompliance{{/str}}</p>{{/hashistory}}
    {{/isfixed}}

    {{#islinks}}
        {{#links.cancheck}}
            <form method="post" action="{{links.checkurl}}" class="mb-3">
                <input type="hidden" name="sesskey" value="{{sesskey}}">
                <input type="hidden" name="action" value="checklinks">
                <button type="submit" class="btn btn-outline-secondary" title="{{#str}}links:check_tooltip, local_chronifycompliance{{/str}}"{{#links.busy}} disabled{{/links.busy}}>{{#pix}}i/link, core{{/pix}} {{#str}}links:check, local_chronifycompliance{{/str}}</button>
            </form>
        {{/links.cancheck}}
        {{#links}}{{> local_chronifycompliance/links_panel }}{{/links}}
    {{/islinks}}
</div>
