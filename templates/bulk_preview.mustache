{{!
    @template local_chronifycompliance/bulk_preview

    Combined preview of the one click fixes of the selected courses.

    Example context (json):
    {
        "count": 1, "courses": 1, "needsinput": 2, "over": 0, "canapply": true, "hasitems": true,
        "items": [{"findingid": 5, "courseid": 3, "coursename": "Safety Onboarding", "checkname": "Activity added after setup",
            "message": "Quiz 2 tracks completion but is not a course completion condition.",
            "rows": [{"label": "Course completion conditions", "before": "Quiz 1", "after": "Quiz 1, Quiz 2"}],
            "warnings": [], "error": ""}]
    }
}}
<div data-region="bulk-preview">
    {{#hasitems}}
        <p>{{#str}}bulk:summary, local_chronifycompliance, {"count": {{count}}, "courses": {{courses}} }{{/str}}</p>
        <ul class="list-unstyled mb-2">
            {{#items}}
                <li class="border rounded p-2 mb-2" data-findingid="{{findingid}}">
                    <div class="fw-bold">{{coursename}}: {{checkname}}</div>
                    <div class="small mb-1">{{message}}</div>
                    {{#rows.0}}
                        <table class="table table-sm small mb-1">
                            <thead><tr>
                                <th scope="col">{{#str}}report:setting, local_chronifycompliance{{/str}}</th>
                                <th scope="col">{{#str}}report:before, local_chronifycompliance{{/str}}</th>
                                <th scope="col">{{#str}}report:after, local_chronifycompliance{{/str}}</th>
                            </tr></thead>
                            <tbody>
                                {{#rows}}<tr><td>{{label}}</td><td>{{before}}</td><td>{{after}}</td></tr>{{/rows}}
                            </tbody>
                        </table>
                    {{/rows.0}}
                    {{#warnings}}<div class="small text-warning">{{.}}</div>{{/warnings}}
                    {{#error}}<div class="small text-danger">{{#str}}bulk:skipped, local_chronifycompliance, {{error}}{{/str}}</div>{{/error}}
                </li>
            {{/items}}
        </ul>
    {{/hasitems}}
    {{^hasitems}}<p>{{#str}}bulk:none, local_chronifycompliance{{/str}}</p>{{/hasitems}}
    {{#needsinput}}<p class="small text-muted mb-1">{{#str}}bulk:needsinput, local_chronifycompliance, {{needsinput}}{{/str}}</p>{{/needsinput}}
    {{#over}}<p class="small text-muted mb-0">{{#str}}bulk:over, local_chronifycompliance, {{over}}{{/str}}</p>{{/over}}
</div>
