{{!
    @template local_chronifycompliance/workspace_nav

    Top navigation between the workspaces.

    Example context (json):
    {
        "items": [
            {"key": "dashboard", "label": "Dashboard", "url": "https://example.com/local/chronifycompliance/index.php", "active": true},
            {"key": "completion", "label": "Completion", "url": "https://example.com/local/chronifycompliance/completion.php", "active": false}
        ]
    }
}}
<nav class="local-chronifycompliance-nav mb-3" aria-label="{{#str}}nav:label, local_chronifycompliance{{/str}}">
    <ul class="nav nav-tabs">
        {{#items}}
            <li class="nav-item">
                <a class="nav-link{{#active}} active{{/active}}" href="{{url}}" data-key="{{key}}"{{#active}} aria-current="page"{{/active}}>{{label}}</a>
            </li>
        {{/items}}
    </ul>
</nav>
