{{!
    @template local_chronifycompliance/dashboard_header

    Top of the Completion workspace: scan line, health tiles, view chips and the bulk fix bar.

    Example context (json):
    {
        "nav": "", "status": "193 of 193 courses checked", "lastscan": "Last full scan: 1:30 AM today, 193 courses",
        "canscan": true, "cancancel": false, "canfix": true,
        "scanurl": "https://example.com/local/chronifycompliance/completion.php", "sesskey": "abc",
        "tiles": [{"group": "critical", "label": "Courses with critical problems", "value": 38,
            "detail": "Critical findings: 39", "url": "https://example.com/?view=critical", "active": false}],
        "chips": [{"label": "All 193", "url": "https://example.com/", "active": true}],
        "checkname": null, "clearurl": "https://example.com/"
    }
}}
<div class="local-chronifycompliance-dashboard local-chronifycompliance-completion mb-3">
    <h2 class="h3 mb-2">{{#str}}dashboard:title, local_chronifycompliance{{/str}}</h2>
    {{{nav}}}
    <div class="d-flex flex-wrap justify-content-between align-items-start mb-3">
        <div class="me-3 mb-2">
            <div class="small text-muted">{{#lastscan}}{{lastscan}}. {{/lastscan}}{{status}}</div>
            <div class="small mt-1" data-region="scan-progress" aria-live="polite"></div>
        </div>
        <div class="d-flex flex-wrap mb-2">
            {{#canscan}}
                <form method="post" action="{{scanurl}}">
                    <input type="hidden" name="sesskey" value="{{sesskey}}">
                    <input type="hidden" name="action" value="scan">
                    <button type="submit" class="btn btn-outline-secondary">{{#str}}dashboard:scanall, local_chronifycompliance{{/str}}</button>
                </form>
            {{/canscan}}
            {{#cancancel}}
                <form method="post" action="{{scanurl}}" class="ms-2">
                    <input type="hidden" name="sesskey" value="{{sesskey}}">
                    <input type="hidden" name="action" value="cancel">
                    <button type="submit" class="btn btn-outline-secondary">{{#str}}dashboard:cancelscan, local_chronifycompliance{{/str}}</button>
                </form>
            {{/cancancel}}
        </div>
    </div>

    <div class="lcd-tiles lcc-tiles-3 mb-3">
        {{#tiles}}
            <a class="lcd-tile lcd-tile-{{group}}{{#active}} lcd-active{{/active}}" href="{{url}}"{{#active}} aria-current="true"{{/active}}>
                <span class="lcd-tile-label">{{label}}</span>
                <span class="lcd-tile-value">{{value}}</span>
                <span class="lcd-tile-detail">{{detail}}</span>
            </a>
        {{/tiles}}
    </div>

    <nav class="lcd-chips mb-2" aria-label="{{#str}}dashboard:courses, local_chronifycompliance{{/str}}">
        {{#chips}}<a class="lcd-chip{{#active}} lcd-active{{/active}}" href="{{url}}"{{#active}} aria-current="true"{{/active}}>{{label}}</a>{{/chips}}
        {{#checkname}}<span class="lcd-chip lcd-active">{{checkname}} <a href="{{clearurl}}" class="ms-1" aria-label="{{#str}}dashboard:clearfilter, local_chronifycompliance{{/str}}">&times;</a></span>{{/checkname}}
    </nav>

    {{#canfix}}
        <div class="d-flex flex-wrap align-items-center mb-2" data-region="bulk-fix">
            <button type="button" class="btn btn-primary btn-sm me-2" data-action="cc-bulk-fix">
                {{#str}}bulk:button, local_chronifycompliance{{/str}}
            </button>
            <span class="small text-muted">{{#str}}bulk:help, local_chronifycompliance{{/str}}</span>
        </div>
    {{/canfix}}
</div>
