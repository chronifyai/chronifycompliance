{{!
    @template local_chronifycompliance/dashboard_header

    Site dashboard header: title and scan action, health tiles, top problems, site health and view chips.

    Example context (json):
    {
        "status": "193 of 193 courses checked", "canscan": true, "cancancel": false,
        "scanurl": "https://example.com/local/chronifycompliance/index.php", "sesskey": "abc",
        "tiles": [{"group": "critical", "label": "Courses with critical problems", "value": 38,
            "detail": "39 critical findings", "url": "https://example.com/?view=critical", "active": false}],
        "problems": [{"checkid": "nocriteria", "name": "No completion conditions", "severityname": "critical",
            "severitylabel": "Critical", "courses": 49, "courseslabel": "49 courses", "percent": 100, "url": "https://example.com/?checkid=nocriteria",
            "active": false}],
        "hasproblems": true,
        "sitehealth": [{"ok": true, "neutral": false, "text": "Cron is running"}],
        "chips": [{"label": "All 193", "url": "https://example.com/", "active": true}],
        "checkname": null, "clearurl": "https://example.com/"
    }
}}
<div class="local-chronifycompliance-dashboard mb-3">
    <div class="d-flex flex-wrap justify-content-between align-items-start mb-3">
        <div class="me-3 mb-2">
            <h2 class="h3 mb-1">{{#str}}dashboard:title, local_chronifycompliance{{/str}}</h2>
            <div class="text-muted small">{{status}}</div>
            <div class="small mt-1" data-region="scan-progress" aria-live="polite"></div>
        </div>
        <div class="d-flex flex-wrap mb-2">
            {{#canscan}}
                <form method="post" action="{{scanurl}}">
                    <input type="hidden" name="sesskey" value="{{sesskey}}">
                    <input type="hidden" name="action" value="scan">
                    <button type="submit" class="btn btn-primary">{{#pix}}i/reload, core{{/pix}} {{#str}}dashboard:scanall, local_chronifycompliance{{/str}}</button>
                </form>
            {{/canscan}}
            {{#cancancel}}
                <form method="post" action="{{scanurl}}" class="ms-2">
                    <input type="hidden" name="sesskey" value="{{sesskey}}">
                    <input type="hidden" name="action" value="cancel">
                    <button type="submit" class="btn btn-outline-secondary">{{#str}}dashboard:cancelscan, local_chronifycompliance{{/str}}</button>
                </form>
            {{/cancancel}}
        </div>
    </div>

    <div class="lcd-tiles mb-3">
        {{#tiles}}
            <a class="lcd-tile lcd-tile-{{group}}{{#active}} lcd-active{{/active}}" href="{{url}}"{{#active}} aria-current="true"{{/active}}>
                <span class="lcd-tile-label">{{label}}</span>
                <span class="lcd-tile-value">{{value}}</span>
                <span class="lcd-tile-detail">{{detail}}</span>
            </a>
        {{/tiles}}
    </div>

    <div class="lcd-panels mb-3">
        <section class="card lcd-panel">
            <div class="card-body">
                <h3 class="h6 mb-3">{{#str}}dashboard:topproblems, local_chronifycompliance{{/str}}</h3>
                {{#hasproblems}}
                    <ul class="list-unstyled mb-1">
                        {{#problems}}
                            <li>
                                <a class="lcd-problem{{#active}} lcd-active{{/active}}" href="{{url}}">
                                    <span class="lcd-problem-name"><span class="lcd-pill lcd-pill-{{severityname}}" title="{{severitylabel}}">{{severitylabel}}</span> {{name}}</span>
                                    <span class="lcd-bar" aria-hidden="true"><span class="lcd-bar-fill lcd-bar-{{severityname}}" style="width: {{percent}}%"></span></span>
                                    <span class="lcd-problem-count">{{courseslabel}}</span>
                                </a>
                            </li>
                        {{/problems}}
                    </ul>
                    <div class="small text-muted">{{#str}}dashboard:topproblems:help, local_chronifycompliance{{/str}}</div>
                {{/hasproblems}}
                {{^hasproblems}}<p class="text-muted mb-0">{{#str}}dashboard:noproblems, local_chronifycompliance{{/str}}</p>{{/hasproblems}}
            </div>
        </section>
        <section class="card lcd-panel">
            <div class="card-body">
                <h3 class="h6 mb-3">{{#str}}dashboard:sitehealth, local_chronifycompliance{{/str}}</h3>
                <ul class="list-unstyled mb-0">
                    {{#sitehealth}}
                        <li class="lcd-health">
                            {{#neutral}}<span class="lcd-dot lcd-dot-neutral" aria-hidden="true"></span>{{/neutral}}
                            {{^neutral}}{{#ok}}<span class="lcd-dot lcd-dot-ok" aria-hidden="true"></span>{{/ok}}{{^ok}}<span class="lcd-dot lcd-dot-bad" aria-hidden="true"></span>{{/ok}}{{/neutral}}
                            <span>{{text}}</span>
                        </li>
                    {{/sitehealth}}
                </ul>
            </div>
        </section>
    </div>

    <h3 class="h5 mb-2">{{#str}}dashboard:courses, local_chronifycompliance{{/str}}</h3>
    <nav class="lcd-chips mb-2" aria-label="{{#str}}dashboard:courses, local_chronifycompliance{{/str}}">
        {{#chips}}<a class="lcd-chip{{#active}} lcd-active{{/active}}" href="{{url}}"{{#active}} aria-current="true"{{/active}}>{{label}}</a>{{/chips}}
        {{#checkname}}<span class="lcd-chip lcd-active">{{checkname}} <a href="{{clearurl}}" class="ms-1" aria-label="{{#str}}dashboard:clearfilter, local_chronifycompliance{{/str}}">&times;</a></span>{{/checkname}}
    </nav>
</div>
