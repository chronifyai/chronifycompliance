{{!
    @template local_completiondoctor/scan_progress

    Progress of the latest site scan.

    Example context (json):
    {
        "scanid": 3, "running": true, "finished": false, "total": 200, "done": 50, "failed": 0, "percent": 25,
        "timefinished": null
    }
}}
{{#scanid}}
    {{#running}}
        <div class="small mb-1">{{#str}}dashboard:scanprogress, local_completiondoctor, {"done": {{done}}, "total": {{total}}, "failed": {{failed}} }{{/str}}</div>
        <div class="progress" style="height: 1rem;">
            <div class="progress-bar" role="progressbar" style="width: {{percent}}%" aria-valuenow="{{percent}}" aria-valuemin="0" aria-valuemax="100">{{percent}}%</div>
        </div>
    {{/running}}
    {{#finished}}
        <div class="small text-muted">{{#str}}dashboard:scanfinished, local_completiondoctor, {"done": {{done}}, "failed": {{failed}}, "time": {{#quote}}{{timefinished}}{{/quote}} }{{/str}}</div>
    {{/finished}}
{{/scanid}}
