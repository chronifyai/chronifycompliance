{{!
    @template local_chronifycompliance/guided_review

    Last step of a guided fix: the exact changes, warnings, then Apply.

    Example context (json):
    {
        "stepof": "Step 3 of 3", "error": "", "hasrows": true, "canapply": true,
        "rows": [{"label": "Password length", "before": "8", "after": "12"}],
        "warnings": ["New passwords must follow the policy."],
        "actionurl": "#", "backurl": "#", "cancelurl": "#", "sesskey": "abc"
    }
}}
<div data-region="guided-review">
    <p class="text-muted small mb-1">{{stepof}}</p>
    <h3 class="h5">{{#str}}guided:review, local_chronifycompliance{{/str}}</h3>
    <p>{{#str}}guided:review:intro, local_chronifycompliance{{/str}}</p>
    {{#error}}<div class="alert alert-danger">{{error}}</div>{{/error}}
    {{#hasrows}}
        <table class="table table-sm">
            <caption class="lcd-visually-hidden">{{#str}}report:changes, local_chronifycompliance{{/str}}</caption>
            <thead>
                <tr>
                    <th scope="col">{{#str}}report:setting, local_chronifycompliance{{/str}}</th>
                    <th scope="col">{{#str}}report:before, local_chronifycompliance{{/str}}</th>
                    <th scope="col">{{#str}}report:after, local_chronifycompliance{{/str}}</th>
                </tr>
            </thead>
            <tbody>
                {{#rows}}<tr><td>{{label}}</td><td>{{before}}</td><td><strong>{{after}}</strong></td></tr>{{/rows}}
            </tbody>
        </table>
    {{/hasrows}}
    {{#warnings}}<div class="alert alert-warning">{{.}}</div>{{/warnings}}
    <p class="small text-muted">{{#str}}report:undoable, local_chronifycompliance{{/str}}</p>
    <form method="post" action="{{actionurl}}" class="d-flex flex-wrap">
        <input type="hidden" name="sesskey" value="{{sesskey}}">
        <input type="hidden" name="action" value="apply">
        <a class="btn btn-secondary me-2 mb-1" href="{{backurl}}">{{#str}}back, core{{/str}}</a>
        {{#canapply}}<button type="submit" class="btn btn-primary me-2 mb-1">{{#str}}guided:apply, local_chronifycompliance{{/str}}</button>{{/canapply}}
        <a class="btn btn-link mb-1" href="{{cancelurl}}">{{#str}}cancel, core{{/str}}</a>
    </form>
</div>
