{{!
    @template local_chronifycompliance/completion_footer

    Below the course table of the Completion workspace: SCORM strip, site checks and the invitation.

    Example context (json):
    {
        "scorm": {"text": "SCORM packages: 58 analyzed, 6 activities need attention", "queued": null,
            "url": "https://example.com/local/chronifycompliance/completion.php?view=scorm"},
        "sitehealth": [{"ok": true, "neutral": false, "text": "Cron is running"}],
        "invitation": null
    }
}}
<div class="local-chronifycompliance-dashboard mt-3">
    {{#scorm}}
        <div class="card mb-3" data-region="scorm-strip">
            <div class="card-body py-2 d-flex flex-wrap justify-content-between align-items-center">
                <span>{{text}}{{#queued}} <span class="text-muted small">({{queued}})</span>{{/queued}}</span>
                {{#url}}<a href="{{url}}">{{#str}}completion:scorm:link, local_chronifycompliance{{/str}}</a>{{/url}}
            </div>
        </div>
    {{/scorm}}
    {{#sitehealth.0}}
        <section class="card mb-3" data-region="site-checks">
            <div class="card-body">
                <h3 class="h6 mb-2">{{#str}}dashboard:sitehealth, local_chronifycompliance{{/str}}</h3>
                <ul class="list-unstyled mb-0">
                    {{#sitehealth}}
                        <li class="lcd-health">
                            {{#neutral}}<span class="lcd-dot lcd-dot-neutral" aria-hidden="true"></span>{{/neutral}}
                            {{^neutral}}{{#ok}}<span class="lcd-dot lcd-dot-ok" aria-hidden="true"></span>{{/ok}}{{^ok}}<span class="lcd-dot lcd-dot-bad" aria-hidden="true"></span>{{/ok}}{{/neutral}}
                            <span>{{text}}</span>
                        </li>
                    {{/sitehealth}}
                </ul>
            </div>
        </section>
    {{/sitehealth.0}}
    {{{invitation}}}
</div>
