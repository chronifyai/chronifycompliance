{{!
    @template local_chronifycompliance/ignore_form

    Body of the ignore modal.

    Example context (json):
    {
        "findingid": 3
    }
}}
<div data-region="ignore-form" data-findingid="{{findingid}}">
    <label class="form-label" for="cd-ignore-reason">{{#str}}report:ignorereason, local_chronifycompliance{{/str}}</label>
    <textarea class="form-control" id="cd-ignore-reason" rows="3" maxlength="1000" data-region="ignore-reason"></textarea>
</div>
